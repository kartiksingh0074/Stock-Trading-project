# Database
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Comma-separated list of origins allowed to make auth requests (CSRF protection)
TRUSTED_ORIGINS=

# Finnhub API (https://finnhub.io/) — server-side only, never expose with NEXT_PUBLIC_
FINNHUB_API_KEY=

# Upstash Redis (https://upstash.com) — shared cache + rate limiter for Finnhub calls
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys) — free -> paid upgrade flow
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs created in the Stripe dashboard/CLI for each plan in lib/stripe/plans.ts
STRIPE_PRICE_PRO_STARTER=
STRIPE_PRICE_PRO_PLUS=
